{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/dsh-bio-workflows@0.12.0/schema/software-trial-report.schema.json",
  "title": "Bounded Software Trial Report v1",
  "$comment": "In 0.12.0 this report covers autonomous WDL authoring and deterministic validation only. success remains false even when a separately authorized isolated fixture test produces passing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "generatedAt",
    "outcome",
    "success",
    "software",
    "objective",
    "acceptanceCriteria",
    "planDigest",
    "policyDigest",
    "draft",
    "lastValidation",
    "attempts",
    "failures",
    "stop",
    "readiness",
    "limitations",
    "recommendedNextAction"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "missionId": {
      "type": "string",
      "pattern": "^mission-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "outcome": {
      "enum": ["in_progress", "ready_for_isolated_test", "exhausted", "blocked", "cancelled", "interrupted"]
    },
    "success": { "const": false },
    "software": { "$ref": "#/$defs/software" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "draft": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/draft" }
      ]
    },
    "lastValidation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/validation" }
      ]
    },
    "attempts": { "$ref": "#/$defs/usage" },
    "failures": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/failure" }
    },
    "stop": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/stop" }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftValidated",
        "isolatedTestCompleted",
        "productionExecutionAuthorized",
        "workflowPromotionAuthorized"
      ],
      "properties": {
        "draftValidated": { "type": "boolean" },
        "isolatedTestCompleted": { "const": false },
        "productionExecutionAuthorized": { "const": false },
        "workflowPromotionAuthorized": { "const": false }
      }
    },
    "limitations": {
      "const": [
        "software_container_not_executed",
        "isolated_draft_test_runner_unavailable",
        "report_is_not_production_validation"
      ]
    },
    "recommendedNextAction": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "containerImage"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "containerImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\"'\\\\]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draftId", "revision", "contentDigest"],
      "properties": {
        "draftId": {
          "type": "string",
          "pattern": "^draft-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 256 },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "contentDigest", "validationDigest", "valid", "observedAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1, "maximum": 256 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "validationDigest": { "$ref": "#/$defs/digest" },
        "valid": { "const": true },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "draftCreates", "draftUpdates", "validations", "validationFailures"],
      "properties": {
        "actions": { "type": "integer", "minimum": 0, "maximum": 64 },
        "draftCreates": { "type": "integer", "minimum": 0, "maximum": 4 },
        "draftUpdates": { "type": "integer", "minimum": 0, "maximum": 16 },
        "validations": { "type": "integer", "minimum": 0, "maximum": 64 },
        "validationFailures": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "severity"],
      "properties": {
        "path": { "type": "string", "maxLength": 512 },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["error", "warning"] }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "failureClass",
        "draft",
        "diagnostics",
        "failureFingerprint",
        "evidenceDigest",
        "occurrence",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "failureClass": { "enum": ["wdl_validation", "validation_infrastructure"] },
        "draft": { "$ref": "#/$defs/draft" },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "failureFingerprint": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "occurrence": { "type": "integer", "minimum": 1, "maximum": 16 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "at", "automaticRetry"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "at": { "type": "string", "format": "date-time" },
        "automaticRetry": { "const": false }
      }
    }
  }
}
