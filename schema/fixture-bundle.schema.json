{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/dsh-bio-workflows@0.12.0/schema/fixture-bundle.schema.json",
  "title": "dsh-bio-workflows Fixture Bundle v1",
  "description": "An immutable, declarative fixture bundle for separately authorized isolated WDL draft tests. It contains no executable assertion hooks or host paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "summary",
    "files",
    "inputs",
    "assertions"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "x-maxAggregateBytes": 67108864,
      "items": { "$ref": "#/$defs/file" }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/port" },
      "additionalProperties": { "$ref": "#/$defs/inputValue" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/valueAssertion" },
          { "$ref": "#/$defs/fileAssertion" }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "assertionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!fixture\\.json$)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "port": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/digest" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "fixtureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$fixture"],
      "properties": {
        "$fixture": { "$ref": "#/$defs/path" }
      }
    },
    "inputValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "$ref": "#/$defs/fixtureReference" },
        {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/inputValue" }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "not": { "required": ["$fixture"] },
          "additionalProperties": { "$ref": "#/$defs/inputValue" }
        }
      ]
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "maxProperties": 4096, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ],
      "x-maxDepth": 16,
      "x-maxNodes": 4096
    },
    "valueAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "output", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/assertionId" },
        "kind": { "const": "value_equals" },
        "output": { "$ref": "#/$defs/port" },
        "expected": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "fileAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "output", "sha256", "sizeBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/assertionId" },
        "kind": { "const": "file_digest" },
        "output": { "$ref": "#/$defs/port" },
        "index": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "sha256": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    }
  }
}
