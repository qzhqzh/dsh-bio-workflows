{
  "bundleVersion": "1",
  "manifest": {
    "schemaVersion": "1",
    "id": "bam-qc",
    "version": "1.0.0",
    "name": "BAM quality control",
    "summary": "Run samtools flagstat and stats for one BAM file.",
    "status": "draft",
    "engine": {
      "name": "miniwdl"
    },
    "inputs": [
      {
        "id": "bam",
        "type": "file",
        "required": true,
        "description": "BAM file to inspect."
      },
      {
        "id": "threads",
        "type": "integer",
        "required": false,
        "description": "Threads allocated to samtools."
      }
    ],
    "outputs": [
      {
        "id": "flagstat_report",
        "type": "file",
        "description": "samtools flagstat text report."
      },
      {
        "id": "stats_report",
        "type": "file",
        "description": "samtools stats text report."
      }
    ],
    "tags": [
      "bam",
      "qc",
      "starter",
      "wdl"
    ]
  },
  "wdl": {
    "version": "1.0",
    "entrypoint": "main.wdl",
    "engines": [
      {
        "name": "miniwdl",
        "version": "1.15.0"
      },
      {
        "name": "cromwell"
      }
    ]
  },
  "source": {
    "kind": "builtin",
    "repository": "https://github.com/qzhqzh/dsh-bio-workflows",
    "revision": "0.4.0"
  },
  "authors": [
