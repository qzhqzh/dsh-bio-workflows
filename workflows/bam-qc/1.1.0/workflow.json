{
  "bundleVersion": "1",
  "manifest": {
    "schemaVersion": "1",
    "id": "bam-qc",
    "version": "1.1.0",
    "name": "BAM quality control",
    "summary": "Validate one BAM/BAI pair and return checksummed samtools QC reports.",
    "status": "ready",
    "engine": {
      "name": "miniwdl"
    },
    "inputs": [
      {
        "id": "bam",
        "type": "file",
        "required": true,
        "description": "Canonical .bam file to inspect. The execution adapter snapshots it before launch."
      },
      {
        "id": "bai",
        "type": "file",
        "required": true,
        "description": "Adjacent BAI index named <bam>.bai or <stem>.bai."
      }
    ],
    "outputs": [
      {
        "id": "flagstat_report",
        "type": "file",
        "description": "samtools flagstat text report."
      },
      {
        "id": "stats_report",
        "type": "file",
        "description": "samtools stats text report."
      },
      {
        "id": "idxstats_report",
        "type": "file",
        "description": "samtools idxstats text report proving the index was loaded."
      }
    ],
    "tags": [
      "bam",
      "qc",
      "samtools",
      "wdl"
    ]
  },
  "wdl": {
    "version": "1.0",
    "entrypoint": "main.wdl",
    "engines": [
      {
        "name": "miniwdl",
        "version": "1.15.0"
      },
      {
        "name": "cromwell"
      }
    ]
  },
  "source": {
    "kind": "builtin",
    "repository": "https://github.com/qzhqzh/dsh-bio-workflows",
    "revision": "0.13.0"
  },
  "authors": [
    "dsh-bio-workflows maintainers"
  ],
  "license": "MIT",
  "verification": {
    "status": "verified",
    "checks": [
      "bundle-file-digests",
      "local-import-closure",
      "wdl-source-shape",
      "miniwdl-check@1.15.0",
      "miniwdl-run@1.15.0",
      "container-digest-pinned",
      "docker-swarm-internal-network",
      "bam-bai-contract-v1",
      "rebuilt-bai-byte-match",
      "input-snapshot-sha256",
      "output-artifact-sha256",
      "samtools-summary-v1",
      "cancellation-provenance",
      "example-json"
    ]
  },
  "files": [
