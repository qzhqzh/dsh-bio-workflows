{
  "name": "dsh-bio-workflows",
  "version": "0.3.1",
  "description": "Read-only bioinformatics workflow catalog and declarative preflight for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./catalog": "./src/catalog.js",
    "./manifest": "./src/manifest.js",
    "./preflight": "./src/preflight.js",
    "./schema/workflow-manifest.schema.json": "./schema/workflow-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "schema/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:dsh": "node scripts/smoke-dsh-profile.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bioinformatics",
    "workflow-orchestration"
  ],
  "author": "zhuqin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzhqzh/dsh-bio-workflows.git"
  },
  "homepage": "https://github.com/qzhqzh/dsh-bio-workflows#readme",
  "bugs": {
    "url": "https://github.com/qzhqzh/dsh-bio-workflows/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
